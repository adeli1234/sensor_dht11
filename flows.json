        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<h3>Últimos registros guardados en MariaDB</h3>\n<table border=\"1\" style=\"width:100%; text-align:left; border-collapse:collapse;\">\n  <thead>\n    <tr style=\"background-color:#17272c; color:white;\">\n      <th style=\"padding:6px;\">Hora</th>\n      <th style=\"padding:6px;\">Equipo</th>\n      <th style=\"padding:6px;\">Temp °C</th>\n      <th style=\"padding:6px;\">Hum %</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr ng-repeat=\"row in msg.payload\">\n      <td style=\"padding:6px;\">{{row.Hora}}</td>\n      <td style=\"padding:6px;\">{{row.Equipo}}</td>\n      <td style=\"padding:6px;\"><b>{{row['Temp C']}}</b></td>\n      <td style=\"padding:6px;\">{{row['Hum %']}}</td>\n    </tr>\n  </tbody>\n</table>",
